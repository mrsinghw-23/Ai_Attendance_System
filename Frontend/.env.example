# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_attendance_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password

# Authentication and camera credential encryption
JWT_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
BCRYPT_ROUNDS=12

# Internal Frontend <-> AI service authentication
AI_SERVICE_API_KEY=replace-with-a-long-random-service-key

# Public URL used in password-reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Windows override. The default auto-detects the sibling service venv.
# AI_PYTHON_PATH=E:\AI-Atten-Sytem\AI-Recognition-Service\.venv\Scripts\python.exe
