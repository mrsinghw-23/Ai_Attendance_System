# Database (match Frontend/.env.local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_attendance_db
DB_USER=postgres
DB_PASSWORD=your_password

# Must match Frontend CREDENTIAL_ENCRYPTION_KEY or JWT_SECRET
CREDENTIAL_ENCRYPTION_KEY=AI_ATTENDANCE_SUPER_SECRET_2026

# Frontend API for attendance engine trigger
FRONTEND_API_URL=http://localhost:3000
AI_SERVICE_API_KEY=ai-service-local-key-change-me

# Paths
FRONTEND_PUBLIC_PATH=../Frontend/public

# InsightFace model pack
EMBEDDING_MODEL=buffalo_l

# Optional: process a single camera id (empty = all active cameras)
CAMERA_ID=

# ONNX provider: CPUExecutionProvider or CUDAExecutionProvider
ONNX_PROVIDER=CPUExecutionProvider
